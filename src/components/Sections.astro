---
import type { Section } from '../data/profile';
import { slugify } from '../lib/slug';

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  sections.map((s) => (
    <section class="detail-section" id={s.title ? slugify(s.title) : undefined}>
      {s.title && <h2>{s.title}</h2>}
      {s.description && <p class="muted">{s.description}</p>}
      {s.points && (
        <ul>
          {s.points.map((pt) => (
            <li>
              {pt.label && pt.href && (
                <>
                  <a href={pt.href.startsWith('/') ? `${base}${pt.href}` : pt.href}>{pt.label}</a> —{' '}
                </>
              )}
              {pt.label && !pt.href && <strong>{pt.label}: </strong>}
              {pt.text}
            </li>
          ))}
        </ul>
      )}
      {s.tags && (
        <ul class="tags">
          {s.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )}
    </section>
  ))
}

<style>
  .detail-section + .detail-section {
    margin-top: 2.25rem;
  }
  .detail-section h2 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }
  .detail-section li + li {
    margin-top: 0.6rem;
  }
</style>
