---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { experience } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Experience" description="Research, leadership, and education of Pei-Je Ssu.">
  <h1>Experience</h1>
  <p class="page-intro">Research, leadership, and education. Open one for the details.</p>
  <div class="grid">
    {
      experience.map((e) => (
        <Card
          href={`${base}/experience/${e.slug}`}
          eyebrow={`${e.kind} · ${e.period}`}
          title={e.title}
          subtitle={e.org}
          summary={e.summary}
          tags={e.tags}
        />
      ))
    }
  </div>
</Base>
