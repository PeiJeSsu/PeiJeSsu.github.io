---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { experience } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Experience" description="The roles and education that have shaped Pei-Je Ssu as an engineer.">
  <h1>Experience</h1>
  <p class="page-intro">The roles and education that have shaped me as an engineer.</p>
  <div class="grid">
    {
      experience.map((e) => (
        <Card
          href={`${base}/experience/${e.slug}`}
          eyebrow={`${e.kind} · ${e.period}`}
          title={e.title}
          subtitle={e.shortOrg ?? e.org}
          summary={e.summary}
        />
      ))
    }
  </div>
</Base>
