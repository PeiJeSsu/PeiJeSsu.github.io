---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getPublishedPosts();
---

<Base title="Blog" description="Lessons from building, learning, and growing a career in tech.">
  <h1>Blog</h1>
  <p class="page-intro">Lessons from building, learning, and growing a career in tech.</p>
  <div class="readable">
  {
    posts.length === 0 ? (
      <p class="empty muted">First posts are on the way — check back soon.</p>
    ) : (
      posts.map((post) => (
        <a class="entry post" href={`${base}/blog/${post.id}`}>
          <div class="entry-head">
            <h3>{post.data.title}</h3>
            <span class="meta">{formatDate(post.data.date)}</span>
          </div>
          <p class="muted">{post.data.description}</p>
        </a>
      ))
    )
  }
  </div>
</Base>

<style>
  .post {
    display: block;
    color: var(--text);
  }
  .post:hover {
    text-decoration: none;
  }
  .post:hover h3 {
    color: var(--accent);
  }
  .post p {
    margin: 0.3rem 0 0;
  }
  .empty {
    padding: 2rem;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: 12px;
  }
</style>
