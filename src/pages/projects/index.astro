---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { projects } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Projects" description="Selected software projects by Pei-Je Ssu.">
  <h1>Projects</h1>
  <p class="page-intro">Things I've built, mostly as a team lead. Open one to see the engineering behind it.</p>
  <div class="grid">
    {
      projects.map((p) => (
        <Card
          href={`${base}/projects/${p.slug}`}
          eyebrow={p.period}
          title={p.name}
          subtitle={`${p.role} · ${p.context}`}
          summary={p.summary}
          tags={p.stack}
        />
      ))
    }
  </div>
</Base>
