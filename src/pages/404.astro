---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page Not Found" description="This page doesn't exist." noindex>
  <h1>Page not found</h1>
  <p class="page-intro">This page doesn't exist or may have moved.</p>
  <div class="actions">
    <a class="btn primary" href={`${base}/`}>Back to home</a>
    <a class="btn" href={`${base}/projects`}>Projects</a>
    <a class="btn" href={`${base}/experience`}>Experience</a>
    <a class="btn" href={`${base}/resume`}>Resume</a>
  </div>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
